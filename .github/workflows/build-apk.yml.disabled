name: Build APK

on:
  workflow_dispatch:
  workflow_call:
    inputs:
      version:
        type: string
        description: "Version tag (e.g. 0.5.0)"
        default: ""
    outputs:
      version:
        value: ${{ jobs.build.outputs.version }}

jobs:
  build:
    runs-on: ubuntu-latest
    outputs:
      version: ${{ steps.meta.outputs.version }}
    steps:
      - uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          java-version: "17"
          distribution: temurin

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Extract metadata
        id: meta
        run: |
          VERSION="${{ inputs.version }}"
          VERSION="${VERSION#v}"
          if [ -z "$VERSION" ]; then
            VERSION="dev-$(date +%Y%m%d-%H%M%S)"
          fi
          echo "version=${VERSION}" >> $GITHUB_OUTPUT

      - name: Flutter doctor
        working-directory: android_app
        run: flutter doctor -v

      - name: Install Flutter dependencies
        working-directory: android_app
        run: flutter pub get

      - name: Diagnostics - list Android project files
        run: |
          echo "=== Android project root files ==="
          ls -la android_app/android/ || echo "MISSING"
          echo "=== settings.gradle.kts ==="
          cat android_app/android/settings.gradle.kts || echo "MISSING"
          echo "=== build.gradle.kts (root) ==="
          cat android_app/android/build.gradle.kts || echo "MISSING"
          echo "=== gradle-wrapper.properties ==="
          cat android_app/android/gradle/wrapper/gradle-wrapper.properties || echo "MISSING"
          echo "=== local.properties ==="
          cat android_app/android/local.properties || echo "MISSING"
          echo "=== AndroidManifest.xml (first 50 lines) ==="
          head -50 android_app/android/app/src/main/AndroidManifest.xml
          echo "=== styles.xml ==="
          cat android_app/android/app/src/main/res/values/styles.xml || echo "MISSING"
          echo "=== mipmap files ==="
          find android_app/android/app/src/main/res/mipmap-* -type f 2>/dev/null || echo "NONE"

      - name: Build release APK
        working-directory: android_app
        run: flutter build apk --release

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: cc-monitor-${{ steps.meta.outputs.version }}
          path: android_app/build/app/outputs/flutter-apk/app-release.apk
